# ============================================================
# Credenciais da Tuya Cloud
# Onde encontrar: platform.tuya.com > Cloud > seu projeto >
# aba "Overview" > seção "Authorization Key"
# ============================================================

# "Access ID / Client ID" do seu projeto na Tuya IoT Platform
TUYA_ACCESS_KEY=your_access_id_here

# "Access Secret / Client Secret" do seu projeto na Tuya IoT Platform
TUYA_SECRET_KEY=your_access_secret_here

# Data Center do projeto (precisa bater com a região escolhida na criação do projeto)
#   China : https://openapi.tuyacn.com
#   EUA   : https://openapi.tuyaus.com
#   Europa: https://openapi.tuyaeu.com
#   Índia : https://openapi.tuyain.com
TUYA_ENDPOINT=https://openapi.tuyaus.com

# ID do dispositivo Hub Smart IR (aba "Devices" do projeto, ou
# via app Tuya Smart/Smart Life > dispositivo > Configurações > Informações do dispositivo)
TUYA_DEVICE_ID=your_ir_hub_device_id_here
